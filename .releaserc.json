{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "cd packages/react && npm version ${nextRelease.version} --no-git-tag-version --allow-same-version --no-workspaces",
        "publishCmd": "cd packages/react && npm publish --no-workspaces --access public --loglevel verbose"
      }
    ],
    "@semantic-release/github"
  ]
}
